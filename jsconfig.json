{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Node",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.js",
    "src/types/**/*.d.ts"
  ]
}
