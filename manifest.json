{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.0.0",
  "description": "__MSG_extensionDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-workspace-manager@dvestezar.cz",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "sessions",
    "tabGroups",
    "alarms"
  ],
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "src/popup/popup.html",
    "default_icon": "assets/icon.svg"
  },
  "icons": {
    "32": "assets/icon.svg",
    "64": "assets/icon.svg",
    "128": "assets/icon.svg"
  },
  "developer": {
    "name": "dvestezar.cz",
    "url": "https://dvestezar.cz/"
  },
  "default_locale": "en"
}
